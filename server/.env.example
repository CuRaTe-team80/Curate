# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/curate

# Port the server listens on
PORT=5000

# Allowed client origin for CORS.
# Use '*' for local development.
# In production, set this to the deployed client URL, e.g. https://curate-app.vercel.app
CORS_ORIGIN=*

# JWT secret used to sign auth tokens (ask Ishini for the required format/value)
JWT_SECRET=your_jwt_secret_here